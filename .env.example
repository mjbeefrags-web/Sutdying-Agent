APP_ENV=development
APP_NAME=Study Platform API
DATABASE_URL=postgresql+psycopg://study:study@postgres:5432/study
REDIS_URL=redis://redis:6379/0
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=study
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=study-platform@localhost
OUTBOX_ENCRYPTION_KEY=
MINIO_ROOT_USER=study-local
MINIO_ROOT_PASSWORD=local-development-secret-change-me
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=study-local
STORAGE_SECRET_KEY=local-development-secret-change-me
STORAGE_BUCKET=study-documents
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKET=true
MAX_DOCUMENT_UPLOAD_BYTES=26214400
MAX_DOCUMENT_PAGES=250
MAX_DOCUMENT_CHUNKS=500
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
